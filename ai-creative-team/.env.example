# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_AI_STUDIO_KEY=

# --- Image generator ---
NANO_BANANA_API_KEY=nb-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NANO_BANANA_ENDPOINT=https://api.nanobanana.ai/v1/generate

# --- Airtable review board ---
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
AIRTABLE_TABLE_NAME=Creative Review

# --- Cost control ---
MAX_IMAGES_PER_RUN=10
MAX_USD_PER_RUN=5.00
MAX_TOKENS_PER_CALL=8000

# --- Runtime ---
LOG_LEVEL=INFO
DEFAULT_BRAND=
